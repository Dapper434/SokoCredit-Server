FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
DATABASE_URL=sqlite:///sokocredit.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# M-Pesa Daraja Sandbox (generate key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MPESA_ENC_KEY=
MPESA_WEBHOOK_TOKEN=soko-sandbox-webhook
MPESA_CALLBACK_BASE_URL=http://localhost:5000
MPESA_TRUST_ALL_WEBHOOK_IPS=1
FAULU_MPESA_CONSUMER_KEY=
FAULU_MPESA_CONSUMER_SECRET=
MPESA_SANDBOX_STUB=1  # 1 = skip real Daraja call (demo without app creds/ngrok); 0 = real Sandbox STK

# Supabase storage — KYC/compliance document uploads (foundations.storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
SIGNED_URL_EXPIRES_IN_SECONDS=300

# Twilio — Collections/Communications SMS + WhatsApp (collections.notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_FROM_NUMBER=

# Flask-Mail — institution-wide email (collections)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
